APP_ENV=production
APP_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_TIMEZONE=Asia/Kolkata
COMPANY_NAME=JAYALAKSHMI MUTUALLY AIDED COOPERATIVE THRIFT AND CREDIT SOCIETY LTD
ADMIN_PUBLIC_URL=https://admin.yeedipay.in
SUPER_ADMIN_PUBLIC_URL=https://superadmin.yeedipay.in
PAY_PUBLIC_URL=https://customer.yeedipay.in
SMS_DEMO_PUBLIC_URL=https://sms-demo.yeedipay.in
PENDING_RECHECK_DAYS=7
ALLOW_AMOUNT_ENTRY=false
# Set false on http://localhost. Keep true behind HTTPS.
SESSION_COOKIE_SECURE=true
PAYMENT_QR_TTL_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=6
# Keep disabled in production; webhook and return URLs must use HTTPS.
WEBHOOK_ALLOW_HTTP=0

# Optional client payment-link API (customer portal integrations)
CLIENT_API_KEY=
CLIENT_API_NAME=Integration Client
CLIENT_API_CUSTOMER=CUST0001

# smslogin.co — live SMS (API key stays in .env, never in git)
SMS_USERNAME=
SMS_APIKEY=
SMS_SENDER_ID=JLKCBK
SMS_OTP_TEMPLATE_ID=
SMS_PENDING_TEMPLATE_ID=
SMS_SUCCESS_TEMPLATE_ID=
SMS_FAILED_TEMPLATE_ID=
SMS_EXPIRED_TEMPLATE_ID=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yeedipay
DB_USER=yeedipay_user
DB_PASS=CHANGE_ME

# Set true only temporarily if you use the optional web installer.
ALLOW_WEB_SETUP=false

# Razorpay (Orders + Checkout + verified webhook).
# All Razorpay credentials are stored ENCRYPTED in the database via the admin
# "Payment Gateway" screen, NOT here. Keep secrets out of .env and git.
# Configure the webhook in the Razorpay Dashboard to point at:
#   https://customer.yeedipay.in/api/razorpay/webhook
# subscribing to: payment.captured, payment.failed, order.paid
